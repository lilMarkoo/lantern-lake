[Unit]
Description=Lantern Lake relay (online room codes)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/lantern-relay/relay.py --port 24690
Restart=always
RestartSec=3
# runs as a throwaway user with no rights to anything else on the machine
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallFilter=@system-service
MemoryMax=300M
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
